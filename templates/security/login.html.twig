{% extends 'base.html.twig' %}

{% block title %}Connexion administration{% endblock %}

{% block body %}
    <main class="login-page">
        <h1>Connexion administration</h1>

        {% if error %}
            <p role="alert">Identifiants incorrects ou connexion refusée.</p>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <label for="login-email">E-mail</label>
            <input
                id="login-email"
                type="email"
                name="_username"
                value="{{ last_username }}"
                autocomplete="username"
                required
                autofocus
            >

            <label for="login-password">Mot de passe</label>
            <input
                id="login-password"
                type="password"
                name="_password"
                autocomplete="current-password"
                required
            >

            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit">Se connecter</button>
        </form>
    </main>

    <style>
        .login-page {
            max-width: 420px;
            margin: 4rem auto;
            padding: 0 1rem;
        }

        .login-page form {
            display: grid;
            gap: .8rem;
        }

        .login-page input {
            padding: .75rem;
            border: 1px solid #aaa;
            border-radius: 0;
        }

        .login-page button {
            margin-top: .5rem;
            padding: .8rem;
            background: #111;
            color: #fff;
            border: 0;
            cursor: pointer;
        }
    </style>
{% endblock %}
